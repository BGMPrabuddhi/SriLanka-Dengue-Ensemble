# Environment settings for the Sri Lanka dengue early-warning project.
# Copy to .env (git ignores .env). No secrets are needed: the denguedatahub data (GitHub) and the
# Open-Meteo weather API are public and require no API key.
# VS Code (Python / Jupyter extensions) loads .env automatically; Streamlit reads STREAMLIT_* variables
# from the environment.

# make the `src` package importable when running from the repository root
PYTHONPATH=.
# UTF-8 console output on Windows
PYTHONIOENCODING=utf-8

# Streamlit dashboard (app/app.py)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
